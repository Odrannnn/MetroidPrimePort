<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.odrannnn.metroidprimeport</id>
  <metadata_license>MIT</metadata_license>
  <project_license>LicenseRef-mixed</project_license>

  <name>Metroid Prime Port</name>
    <!-- The icon the desktop entry names, installed by the project's own rules to
       share/icons/hicolor/scalable/apps. Without this declaration appstreamcli
       compose finds the file by convention and then cannot resolve it, which is
       reported as file-read-error. -->
  <icon type="stock">io.github.odrannnn.metroidprimeport</icon>
  <!-- AppStream categories, which are a different list from the desktop
       entry's XDG ones. Without this the desktop file's Categories=Game has
       nothing to map onto and compose reports both app-categories-missing
       and filters-but-no-output. -->
  <categories>
    <category>Game</category>
  </categories>
<summary>Metroid Prime running natively, with randomizer and Archipelago support</summary>

  <description>
    <p>
      A native recompilation of Metroid Prime. The game is played as it was
      released, on the host's own Vulkan driver, with no emulator in the loop and
      no disc image bundled: the port asks for your own copy of the disc on first
      launch.
    </p>
    <p>Features:</p>
    <ul>
      <li>Randomizer, with a full world and layer sweep covering every area</li>
      <li>Archipelago multiworld, over ws:// and wss://</li>
      <li>DeathLink, opt-in</li>
      <li>Controller button prompts rebuilt for the device in use</li>
      <li>Memory card saves in the GCI format the series used</li>
    </ul>
    <p>
      This package contains no game assets. It will not play without a disc image
      you supply, and none is distributed with it.
    </p>
  </description>

  <launchable type="desktop-id">io.github.odrannnn.metroidprimeport.desktop</launchable>

  <url type="homepage">https://github.com/Odrannnn/MetroidPrimePort</url>
  <url type="bugtracker">https://github.com/Odrannnn/MetroidPrimePort/issues</url>

  <developer id="org.metroidprime">
    <name>The Metroid Prime Port contributors</name>
  </developer>

  <content_rating type="oars-1.1"/>

  <!-- Newest first. A release adds its entry here when it bumps versionName in
       android/app/build.gradle; tools/make_flatpak.sh refuses to build when the
       two differ, since Flatpak reports the newest entry as the app's version. -->
  <releases>
    <release version="0.21.0" date="2026-10-10">
      <description>
        <p>Improves controller remapping and projected-blend lighting in Remastered imports.</p>
      </description>
      <url type="details">https://github.com/Odrannnn/MetroidPrimePort/releases/tag/v0.21.0</url>
    </release>
    <release version="0.20.0" date="2026-10-10">
      <url type="details">https://github.com/Odrannnn/MetroidPrimePort/releases/tag/v0.20.0</url>
    </release>
    <release version="0.19.0" date="2026-10-09">
      <url type="details">https://github.com/Odrannnn/MetroidPrimePort/releases/tag/v0.19.0</url>
    </release>
    <release version="0.18.0" date="2026-10-07">
      <url type="details">https://github.com/Odrannnn/MetroidPrimePort/releases/tag/v0.18.0</url>
    </release>
    <release version="0.1.0" date="2026-09-26">
      <description>
        <p>First packaged release.</p>
      </description>
    </release>
  </releases>

  <requires>
    <display_length compare="ge">640</display_length>
  </requires>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>gamepad</control>
  </recommends>

  <!--
    Deliberately absent: screenshots and a project URL. Screenshots would show
    Nintendo's game, which this package may not redistribute, and there is no
    public project page to point at. Both are Flathub requirements, so this
    component is not publishable as-is - see docs/RELEASING.md.
  -->
</component>
